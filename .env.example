# FlexERP API Configuration
# Copy this file to .env and fill in your actual credentials
# IMPORTANT: Never commit the .env file to version control!

# FlexERP API Base URL
# Default: https://flex-solutions-inc.github.io/FlexERP-Public/
FLEXERP_API_BASE_URL=https://flex-solutions-inc.github.io/FlexERP-Public/

# FlexERP Authentication Credentials
# TODO: Enter your FlexERP credentials below

# Option 1: Username/Password Authentication
FLEXERP_USERNAME=your_username_here
FLEXERP_PASSWORD=your_password_here

# Option 2: API Key Authentication (if applicable)
FLEXERP_API_KEY=your_api_key_here

# Note: Configure either username/password OR api_key based on your FlexERP setup
